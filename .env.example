# Groq API key
GROQ_API_KEY=your_groq_api_key_here

# HTTP User-Agent used when loading web pages
USER_AGENT=EnterpriseAIKnowledgeAssistant/1.0

# PostgreSQL database
DATABASE_URL=postgresql+psycopg://enterprise_user:enterprise_password@localhost:5432/enterprise_ai

# JWT authentication
JWT_SECRET_KEY=your_strong_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60